<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>reCart.Compiler</AssemblyName>
    <RootNamespace>reCart.Compiler</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="reCart.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\reCart.Contracts\reCart.Contracts.csproj" />
    <ProjectReference Include="..\reCart.Core\reCart.Core.csproj" />
    <Reference Include="Foundation.Core">
      <HintPath>..\..\lib\Foundation.Core.dll</HintPath>
    </Reference>
    <Reference Include="Foundation.Retro">
      <HintPath>..\..\lib\Foundation.Retro.dll</HintPath>
    </Reference>
    <Reference Include="reEngine.Core">
      <HintPath>..\..\lib\reEngine.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
